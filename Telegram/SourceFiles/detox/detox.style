// detox.style

using "ui/basic.style";
using "ui/widgets/widgets.style";

detoxScreenBg: windowBg;
detoxScreenFg: windowFg;

detoxTitleFont: font(24px semibold);
detoxTitleColor: windowFg;
detoxTitlePadding: margins(0px, 0px, 0px, 40px);

detoxButton: defaultButton {
    height: 48px;
    textPadding: margins(20px, 0px, 20px, 0px);
}

detoxButtonSpacing: 16px;

detoxTimerBarHeight: 28px;
detoxTimerBarBg: windowBgOver;
detoxTimerBarFg: windowFg;
detoxTimerBarProgress: windowFgActive;
detoxTimerFont: font(13px semibold);
